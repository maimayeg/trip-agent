# Files Docker must NOT copy into the image.

# Secrets: keys are passed in at run time via docker-compose, not built in.
.env
.env.*

# Local virtual environments: the image builds its own.
.venv/
venv/

# Git data, caches and build leftovers
.git/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Not needed to run the app
evals/results/
*.html
.DS_Store
.vscode/
